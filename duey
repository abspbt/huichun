<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Duey" />
  <meta name="theme-color" content="#3d5a73" />
  <title>Duey</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    /* ── 基礎字型 ── */
    @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;600&display=swap');

    * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

    body {
      font-family: 'Noto Sans TC', sans-serif;
      overscroll-behavior: none;
      height: 100dvh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      transition: background-color 0.4s ease;
    }

    /* ── 主題色彩 ── */
    :root {
      --theme-dark:    #3d5a73;
      --theme-mid:     #4a6d87;
      --theme-light:   #5c8099;
      --theme-pale:    #dce8f0;
      --theme-text:    #f0ede8;
      --theme-sub:     #c9d8e3;
      --theme-card-bg: rgba(255,255,255,0.10);
      --theme-card-bd: rgba(255,255,255,0.18);
    }

    /* ────────── 5 個主題 ────────── */
    [data-theme="navy"] {
      --theme-dark:    #2c3e52;
      --theme-mid:     #3a516a;
      --theme-light:   #4d6a82;
      --theme-pale:    #d4dfe8;
      --theme-text:    #eef1f5;
      --theme-sub:     #b8cad8;
      --theme-card-bg: rgba(255,255,255,0.10);
      --theme-card-bd: rgba(255,255,255,0.18);
    }
    [data-theme="forest"] {
      --theme-dark:    #2e4a3a;
      --theme-mid:     #3b5e49;
      --theme-light:   #4e7560;
      --theme-pale:    #d4e5db;
      --theme-text:    #edf3ef;
      --theme-sub:     #b8d4c4;
      --theme-card-bg: rgba(255,255,255,0.10);
      --theme-card-bd: rgba(255,255,255,0.20);
    }
    [data-theme="plum"] {
      --theme-dark:    #3e3050;
      --theme-mid:     #503d65;
      --theme-light:   #664e7e;
      --theme-pale:    #ddd4e8;
      --theme-text:    #f0ecf5;
      --theme-sub:     #c8b8d8;
      --theme-card-bg: rgba(255,255,255,0.10);
      --theme-card-bd: rgba(255,255,255,0.18);
    }
    [data-theme="mocha"] {
      --theme-dark:    #4a3728;
      --theme-mid:     #5e4838;
      --theme-light:   #755c4a;
      --theme-pale:    #e5d8cf;
      --theme-text:    #f5f0eb;
      --theme-sub:     #d4c4b8;
      --theme-card-bg: rgba(255,255,255,0.10);
      --theme-card-bd: rgba(255,255,255,0.18);
    }
    [data-theme="burgundy"] {
      --theme-dark:    #4a2430;
      --theme-mid:     #5e303e;
      --theme-light:   #754050;
      --theme-pale:    #e5d0d5;
      --theme-text:    #f5eeef;
      --theme-sub:     #d4b8be;
      --theme-card-bg: rgba(255,255,255,0.10);
      --theme-card-bd: rgba(255,255,255,0.18);
    }

    /* ── 背景漸層 ── */
    body { background: linear-gradient(160deg, var(--theme-dark) 0%, var(--theme-mid) 55%, var(--theme-light) 100%); }

    /* ── Sticky Banner ── */
    #today-banner {
      background: rgba(0,0,0,0.20);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--theme-card-bd);
      color: var(--theme-text);
      flex-shrink: 0;
      padding-top: env(safe-area-inset-top, 0px);
    }

    /* ── 主題選擇器 ── */
    .theme-btn {
      width: 22px; height: 22px;
      border-radius: 50%;
      border: 2px solid transparent;
      cursor: pointer;
      transition: transform 0.2s, border-color 0.2s;
      flex-shrink: 0;
    }
    .theme-btn:hover  { transform: scale(1.2); }
    .theme-btn.active { border-color: #fff; transform: scale(1.15); }
    .theme-btn[data-t="navy"]     { background: #2c3e52; }
    .theme-btn[data-t="forest"]   { background: #2e4a3a; }
    .theme-btn[data-t="plum"]     { background: #3e3050; }
    .theme-btn[data-t="mocha"]    { background: #4a3728; }
    .theme-btn[data-t="burgundy"] { background: #4a2430; }

    /* ── 任務清單滾動區 ── */
    #task-list-wrapper {
      flex: 1 1 0;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      padding: 12px 16px;
    }
    #task-list-wrapper::-webkit-scrollbar { display: none; }

    /* ── 卡片基底 ── */
    .task-card {
      background: var(--theme-card-bg);
      border: 1px solid var(--theme-card-bd);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border-radius: 14px;
      margin-bottom: 10px;
      color: var(--theme-text);
      transition: transform 0.15s, opacity 0.3s;
      animation: slideIn 0.25s ease;
    }
    .task-card:active { transform: scale(0.98); }
    @keyframes slideIn {
      from { opacity: 0; transform: translateY(10px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ── 狀態色彩覆蓋 ── */
    .card-expired {
      background: rgba(180, 50, 60, 0.55) !important;
      border-color: rgba(220, 80, 90, 0.55) !important;
      animation: pulse-red 2s infinite, slideIn 0.25s ease;
    }
    .card-urgent {
      background: rgba(160, 100, 30, 0.50) !important;
      border-color: rgba(200, 140, 50, 0.55) !important;
    }
    .card-safe { /* default */ }

    @keyframes pulse-red {
      0%,100% { box-shadow: 0 0 0 0 rgba(220,80,90,0); }
      50%      { box-shadow: 0 0 12px 3px rgba(220,80,90,0.40); }
    }

    /* ── 徽章 ── */
    .badge {
      font-size: 0.68rem;
      font-weight: 600;
      padding: 3px 9px;
      border-radius: 20px;
      letter-spacing: 0.02em;
      white-space: nowrap;
    }
    .badge-expired  { background: rgba(220,80,90,0.85);  color: #fff; }
    .badge-today    { background: rgba(220,80,90,0.85);  color: #fff; }
    .badge-urgent   { background: rgba(200,140,50,0.85); color: #fff; }
    .badge-safe     { background: rgba(255,255,255,0.18);color: var(--theme-sub); }

    /* ── Checkbox ── */
    .task-check {
      width: 22px; height: 22px;
      border-radius: 50%;
      border: 2px solid var(--theme-card-bd);
      background: transparent;
      cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
      transition: background 0.2s, border-color 0.2s;
    }
    .task-check:hover { background: rgba(255,255,255,0.15); }
    .task-check.done  { background: rgba(255,255,255,0.35); border-color: rgba(255,255,255,0.6); }

    /* ── 底部輸入列 ── */
    #input-bar {
      background: rgba(0,0,0,0.28);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-top: 1px solid var(--theme-card-bd);
      flex-shrink: 0;
      padding-bottom: env(safe-area-inset-bottom, 8px);
    }

    .input-field {
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.22);
      border-radius: 10px;
      color: var(--theme-text);
      font-size: 0.9rem;
      padding: 9px 12px;
      outline: none;
      transition: border-color 0.2s, background 0.2s;
      font-family: inherit;
    }
    .input-field::placeholder { color: rgba(255,255,255,0.40); }
    .input-field:focus {
      border-color: rgba(255,255,255,0.55);
      background: rgba(255,255,255,0.18);
    }
    /* date picker 顏色修正 */
    input[type="date"]::-webkit-calendar-picker-indicator { filter: invert(0.8); cursor: pointer; }
    input[type="date"] { color-scheme: dark; }

    .btn-add {
      background: rgba(255,255,255,0.22);
      border: 1px solid rgba(255,255,255,0.35);
      border-radius: 10px;
      color: var(--theme-text);
      font-size: 0.88rem;
      font-weight: 600;
      padding: 9px 18px;
      cursor: pointer;
      transition: background 0.2s, transform 0.1s;
      white-space: nowrap;
      font-family: inherit;
    }
    .btn-add:hover  { background: rgba(255,255,255,0.32); }
    .btn-add:active { transform: scale(0.96); }

    /* ── 空白提示 ── */
    #empty-hint {
      text-align: center;
      color: var(--theme-sub);
      opacity: 0.6;
      padding: 60px 24px;
      font-size: 0.92rem;
      line-height: 1.8;
    }

    /* ── 任務名稱（完成態） ── */
    .task-name { font-size: 0.95rem; font-weight: 500; line-height: 1.3; }
    .task-date { font-size: 0.75rem; opacity: 0.65; margin-top: 2px; }
    .task-time-prefix {
      font-size: 0.78rem;
      opacity: 0.75;
      background: rgba(255,255,255,0.12);
      border-radius: 6px;
      padding: 1px 6px;
      margin-right: 6px;
      display: inline-block;
    }

    /* ── 分隔標題 ── */
    .section-label {
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--theme-sub);
      opacity: 0.7;
      margin: 14px 4px 6px;
    }

    /* ── 刪除確認動畫 ── */
    .task-card.removing {
      animation: fadeOut 0.25s ease forwards;
    }
    @keyframes fadeOut {
      to { opacity: 0; transform: translateX(30px); }
    }

    /* ── tooltip ── */
    #toast {
      position: fixed; bottom: 90px; left: 50%; transform: translateX(-50%);
      background: rgba(0,0,0,0.72);
      color: #fff;
      font-size: 0.82rem;
      padding: 7px 18px;
      border-radius: 20px;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.3s;
      z-index: 999;
      white-space: nowrap;
    }
    #toast.show { opacity: 1; }
  </style>
</head>
<body data-theme="navy">

<!-- ════════════════════════════════
     STICKY TOP BANNER
════════════════════════════════ -->
<header id="today-banner">
  <div style="padding: 10px 16px 8px; display:flex; align-items:center; gap:10px;">

    <!-- 主題色點 -->
    <div style="display:flex; gap:7px; align-items:center;">
      <button class="theme-btn active" data-t="navy"     title="深藍"></button>
      <button class="theme-btn"        data-t="forest"   title="深綠"></button>
      <button class="theme-btn"        data-t="plum"     title="深紫"></button>
      <button class="theme-btn"        data-t="mocha"    title="咖啡"></button>
      <button class="theme-btn"        data-t="burgundy" title="深紅"></button>
    </div>

    <!-- 彈性間距 -->
    <div style="flex:1;"></div>

    <!-- App 名稱 -->
    <span style="font-size:1.1rem; font-weight:600; opacity:0.9; letter-spacing:0.05em;">Duey</span>
  </div>

  <!-- 日期列 -->
  <div style="padding: 0 16px 12px; display:flex; align-items:baseline; gap:10px;">
    <span id="date-text" style="font-size:1.15rem; font-weight:500;"></span>
    <span id="weekday-text" style="font-size:0.85rem; opacity:0.65;"></span>
    <div style="flex:1;"></div>
    <span id="task-count" style="font-size:0.78rem; opacity:0.5;"></span>
  </div>
</header>

<!-- ════════════════════════════════
     MAIN TASK LIST (Scrollable)
════════════════════════════════ -->
<main id="task-list-wrapper">
  <div id="task-list"></div>
  <div id="empty-hint" style="display:none;">
    ✦ 目前沒有任何任務<br>
    <span style="font-size:0.82rem;">在下方輸入框加入你的第一件事吧</span>
  </div>
</main>

<!-- ════════════════════════════════
     STICKY BOTTOM INPUT BAR
════════════════════════════════ -->
<footer id="input-bar">
  <div style="padding: 10px 16px 6px; display:flex; gap:8px; align-items:center;">
    <!-- 任務名稱 -->
    <input
      id="input-name"
      class="input-field"
      type="text"
      placeholder="任務名稱…"
      style="flex:1; min-width:0;"
      maxlength="40"
    />
    <!-- 日期選擇 -->
    <input
      id="input-date"
      class="input-field"
      type="date"
      style="width:140px; flex-shrink:0;"
    />
    <!-- 新增按鈕 -->
    <button id="btn-add" class="btn-add">＋ 新增</button>
  </div>
  <!-- 小提示 -->
  <div style="padding: 0 18px 6px; font-size:0.72rem; opacity:0.4; color:var(--theme-text);">
    提示：名稱開頭可輸入時間，如「每月5日 繳房租」
  </div>
</footer>

<!-- Toast -->
<div id="toast"></div>

<script>
/* ╔══════════════════════════════════════╗
   ║           Duey — Core Logic          ║
   ╚══════════════════════════════════════╝ */

// ── 常數 ──────────────────────────────
const STORAGE_KEY   = 'duey_tasks_v1';
const THEME_KEY     = 'duey_theme_v1';
const WEEKDAYS      = ['星期日','星期一','星期二','星期三','星期四','星期五','星期六'];
const THEME_LABELS  = { navy:'深藍', forest:'深綠', plum:'深紫', mocha:'咖啡', burgundy:'深紅' };

// ── 狀態 ──────────────────────────────
let tasks = [];

// ── 工具函式 ───────────────────────────
/** 取得今天的 YYYY-MM-DD（本地時區） */
function todayStr() {
  const d = new Date();
  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
}

/** 計算剩餘天數（正 = 未來，負 = 過期，0 = 今天） */
function diffDays(targetDateStr) {
  const today  = new Date(todayStr());
  const target = new Date(targetDateStr);
  return Math.round((target - today) / 86400000);
}

/** 格式化日期顯示 */
function fmtDate(str) {
  const [y, m, d] = str.split('-');
  return `${y} 年 ${parseInt(m)} 月 ${parseInt(d)} 日`;
}

/** 生成唯一 ID */
function uid() { return Date.now().toString(36) + Math.random().toString(36).slice(2,6); }

// ── localStorage ──────────────────────
function loadTasks()  { try { tasks = JSON.parse(localStorage.getItem(STORAGE_KEY)) || []; } catch { tasks = []; } }
function saveTasks()  { localStorage.setItem(STORAGE_KEY, JSON.stringify(tasks)); }

// ── 主題 ──────────────────────────────
function applyTheme(t) {
  document.body.setAttribute('data-theme', t);
  document.querySelectorAll('.theme-btn').forEach(b => {
    b.classList.toggle('active', b.dataset.t === t);
  });
  localStorage.setItem(THEME_KEY, t);
  // 更新 meta theme-color
  const colors = { navy:'#2c3e52', forest:'#2e4a3a', plum:'#3e3050', mocha:'#4a3728', burgundy:'#4a2430' };
  document.querySelector('meta[name="theme-color"]').setAttribute('content', colors[t] || '#2c3e52');
}

// ── 頂部日期 ──────────────────────────
function renderBanner() {
  const now = new Date();
  document.getElementById('date-text').textContent =
    `${now.getFullYear()} 年 ${now.getMonth()+1} 月 ${now.getDate()} 日`;
  document.getElementById('weekday-text').textContent = WEEKDAYS[now.getDay()];
  const active = tasks.filter(t => !t.done).length;
  document.getElementById('task-count').textContent = active ? `${active} 件待辦` : '';
}

// ── 徽章 ──────────────────────────────
function getBadge(diff) {
  if (diff < 0)  return { cls:'badge-expired', text:`已過期 ${Math.abs(diff)} 天` };
  if (diff === 0) return { cls:'badge-today',   text:'🔥 今天到期' };
  if (diff <= 3) return { cls:'badge-urgent',  text:`剩 ${diff} 天` };
  return { cls:'badge-safe', text:`剩 ${diff} 天` };
}

// ── 卡片背景 ──────────────────────────
function getCardCls(diff, done) {
  if (done) return 'card-safe';
  if (diff <= 0) return 'card-expired';
  if (diff <= 3) return 'card-urgent';
  return 'card-safe';
}

// ── 解析任務名稱中的時間前綴 ──────────
/**
 * 嘗試把名稱開頭「可能是時間描述」的部分分離出來。
 * 規則：若名稱開頭有「每月XX日」「每週X」「每年」「HH:MM」之類的詞，分離顯示。
 * 否則全部當 main。
 */
function parseNamePrefix(name) {
  // 常見前綴 pattern：數字/中文數字 + 日/月/時 結尾
  const m = name.match(/^([每]?(?:\d{1,2}[:\uff1a]\d{2}|每月\d{1,2}日|每週[一二三四五六日]|每年\d{1,2}月\d{1,2}日|\d{1,2}月\d{1,2}日))\s*/);
  if (m) return { prefix: m[1], main: name.slice(m[0].length) || name };
  return { prefix: '', main: name };
}

// ── 渲染清單 ──────────────────────────
function renderList() {
  const list = document.getElementById('task-list');
  const hint = document.getElementById('empty-hint');

  // 排序：未完成優先（依 diff 升冪），完成的沉底
  const sorted = [...tasks].sort((a, b) => {
    if (a.done !== b.done) return a.done ? 1 : -1;
    return diffDays(a.date) - diffDays(b.date);
  });

  if (sorted.length === 0) {
    list.innerHTML = '';
    hint.style.display = 'block';
    renderBanner();
    return;
  }
  hint.style.display = 'none';

  // 分組標籤
  let lastGroup = null;
  const groupOf = (diff, done) => {
    if (done) return 'done';
    if (diff < 0)  return 'expired';
    if (diff === 0) return 'today';
    if (diff <= 3) return 'urgent';
    return 'safe';
  };
  const groupLabel = { expired:'⚠ 已過期', today:'🔥 今天到期', urgent:'⏰ 緊迫 (1–3 天)', safe:'✓ 安全', done:'✔ 已完成' };

  let html = '';
  sorted.forEach(task => {
    const diff  = diffDays(task.date);
    const grp   = groupOf(diff, task.done);
    const badge = getBadge(diff);
    const cardCls = getCardCls(diff, task.done);
    const { prefix, main } = parseNamePrefix(task.name);
    const doneStyle = task.done ? 'opacity:0.45; text-decoration:line-through;' : '';

    if (grp !== lastGroup) {
      html += `<div class="section-label">${groupLabel[grp]}</div>`;
      lastGroup = grp;
    }

    html += `
    <div class="task-card ${cardCls}" id="card-${task.id}" data-id="${task.id}">
      <div style="padding:13px 14px; display:flex; align-items:center; gap:12px;">
        <!-- Checkbox -->
        <button class="task-check ${task.done?'done':''}" onclick="toggleDone('${task.id}')" aria-label="完成">
          ${task.done ? `<svg width="12" height="12" viewBox="0 0 12 12" fill="none">
            <path d="M2 6l3 3 5-5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>` : ''}
        </button>

        <!-- 內容 -->
        <div style="flex:1; min-width:0; ${doneStyle}">
          <div class="task-name">
            ${prefix ? `<span class="task-time-prefix">${prefix}</span>` : ''}${escHtml(main)}
          </div>
          <div class="task-date">${fmtDate(task.date)}</div>
        </div>

        <!-- 徽章 + 刪除 -->
        <div style="display:flex; flex-direction:column; align-items:flex-end; gap:6px;">
          ${!task.done ? `<span class="badge ${badge.cls}">${badge.text}</span>` : ''}
          <button onclick="removeTask('${task.id}')"
            style="background:none; border:none; cursor:pointer; opacity:0.38; padding:2px 4px; color:var(--theme-text); font-size:1rem; line-height:1;"
            aria-label="刪除">✕</button>
        </div>
      </div>
    </div>`;
  });

  list.innerHTML = html;
  renderBanner();
}

/** HTML 跳脫 */
function escHtml(s) {
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

// ── 操作函式 ──────────────────────────
function toggleDone(id) {
  const t = tasks.find(t => t.id === id);
  if (!t) return;
  t.done = !t.done;
  saveTasks();
  renderList();
  showToast(t.done ? '已標記完成 ✓' : '已取消完成');
}

function removeTask(id) {
  const card = document.getElementById('card-' + id);
  if (card) {
    card.classList.add('removing');
    card.addEventListener('animationend', () => {
      tasks = tasks.filter(t => t.id !== id);
      saveTasks();
      renderList();
    }, { once: true });
  } else {
    tasks = tasks.filter(t => t.id !== id);
    saveTasks();
    renderList();
  }
  showToast('已刪除任務');
}

function addTask() {
  const nameEl = document.getElementById('input-name');
  const dateEl = document.getElementById('input-date');
  const name = nameEl.value.trim();
  const date = dateEl.value;

  if (!name) { shakeInput(nameEl); showToast('請輸入任務名稱'); return; }
  if (!date) { shakeInput(dateEl); showToast('請選擇日期');     return; }

  tasks.push({ id: uid(), name, date, done: false, createdAt: Date.now() });
  saveTasks();
  renderList();

  nameEl.value = '';
  // 日期保留，方便連續輸入同日任務
  nameEl.focus();
  showToast('已新增任務 ✓');
}

// ── 輸入框震動 ────────────────────────
function shakeInput(el) {
  el.style.animation = 'none';
  el.offsetHeight; // reflow
  el.style.animation = 'shake 0.35s ease';
  el.addEventListener('animationend', () => el.style.animation = '', { once: true });
}

// ── Toast ──────────────────────────────
let toastTimer;
function showToast(msg) {
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => el.classList.remove('show'), 1800);
}

// ── 事件綁定 ──────────────────────────
document.getElementById('btn-add').addEventListener('click', addTask);
document.getElementById('input-name').addEventListener('keydown', e => {
  if (e.key === 'Enter') {
    e.preventDefault();
    const dateEl = document.getElementById('input-date');
    if (!dateEl.value) { dateEl.focus(); return; }
    addTask();
  }
});

// 主題按鈕
document.querySelectorAll('.theme-btn').forEach(btn => {
  btn.addEventListener('click', () => applyTheme(btn.dataset.t));
});

// ── 自動刷新（每分鐘更新一次倒數） ──
setInterval(() => { renderList(); }, 60000);

// ── 預設今天日期 ──────────────────────
document.getElementById('input-date').value = todayStr();

// ── 初始化 ──────────────────────────
(function init() {
  loadTasks();
  const saved = localStorage.getItem(THEME_KEY) || 'navy';
  applyTheme(saved);
  renderList();

  // 若沒有任何任務，加入示範資料
  if (tasks.length === 0) {
    const today = new Date();
    const add = (n, name) => {
      const d = new Date(today);
      d.setDate(today.getDate() + n);
      const ds = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
      tasks.push({ id: uid(), name, date: ds, done: false, createdAt: Date.now() });
    };
    add(-1, '回診掛號');
    add(0,  '每月5日 繳房租');
    add(2,  '每週三 剪頭髮');
    add(5,  '初一 拜拜');
    add(12, '每年7月15日 車險續保');
    saveTasks();
    renderList();
  }
})();

